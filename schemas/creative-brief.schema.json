{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:creative-brief",
  "title": "CreativeBrief",
  "description": "The creative intent for one video: goal, audience, platform, duration, tone, hooks and surfaced assumptions.",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "description": "Measurable checks the render must meet; vague asks (\"go all out\") become numbers here. Copied to the VideoSpec.",
      "additionalProperties": false,
      "properties": {
        "hold_ms": {
          "description": "At least one deliberate hold this long, so change feels earned (e.g. 400).",
          "maximum": 5000,
          "minimum": 0,
          "type": "integer"
        },
        "loop": {
          "description": "The piece must loop seamlessly (last frame flows into the first).",
          "type": "boolean"
        },
        "max_frozen_pct": {
          "description": "Most of the runtime that may be frozen, in percent (default 15).",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "max_static_sec": {
          "description": "Longest allowed stretch with no visual change.",
          "exclusiveMinimum": 0,
          "maximum": 60,
          "type": "number"
        },
        "min_changes_per_sec": {
          "description": "Big visual changes per second the render must reach (motion density).",
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5"
      ],
      "type": "string"
    },
    "assumptions": {
      "items": {
        "description": "A value Claude inferred rather than received; surfaced to the user for confirmation.",
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Brief field that was inferred, e.g. `audience`.",
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "value",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "audience": {
      "minLength": 1,
      "type": "string"
    },
    "chosen_hook": {
      "description": "Text of the selected hook; should match a hook candidate.",
      "minLength": 1,
      "type": "string"
    },
    "content_ir_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "desired_action": {
      "description": "What the viewer should do after watching.",
      "minLength": 1,
      "type": "string"
    },
    "goal": {
      "enum": [
        "explain",
        "launch",
        "educate",
        "promote",
        "announce",
        "case_study"
      ],
      "type": "string"
    },
    "hook_candidates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "mechanism": {
            "enum": [
              "curiosity_gap",
              "contrarian",
              "statistic",
              "question",
              "pain_point",
              "promise",
              "story",
              "demo",
              "pattern_interrupt",
              "before_after",
              "mistake",
              "contrarian_claim"
            ],
            "type": "string"
          },
          "scores": {
            "description": "Rubric scores on a 0-10 scale, e.g. clarity, curiosity, relevance, platform_fit.",
            "additionalProperties": {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "text",
          "mechanism",
          "scores"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "inputs": {
      "description": "Answers to the template's inputs, keyed by input id (text, choice value, or project-relative file / asset id).",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
        "type": "string"
      },
      "type": "object"
    },
    "key_messages": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "type": "string"
    },
    "platform": {
      "enum": [
        "instagram_reels",
        "tiktok",
        "youtube_shorts",
        "youtube",
        "linkedin",
        "x",
        "generic"
      ],
      "type": "string"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    },
    "target_duration_sec": {
      "exclusiveMinimum": 0,
      "maximum": 600,
      "type": "number"
    },
    "targets": {
      "description": "Platform contract ids to compile for; copied to the VideoSpec. Defaults to the primary platform's contract.",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "template": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "tone": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "goal",
    "audience",
    "platform",
    "aspect_ratio",
    "target_duration_sec",
    "language",
    "tone",
    "desired_action",
    "hook_candidates",
    "chosen_hook",
    "assumptions"
  ],
  "type": "object"
}
