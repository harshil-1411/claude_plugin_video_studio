{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:title-rules",
  "title": "TitleRules",
  "description": "research-specs/titles.yaml: title heuristics (length band) as dated data; warnings only.",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "enum": [
        "heuristic",
        "measured"
      ],
      "type": "string"
    },
    "id": {
      "const": "titles",
      "type": "string"
    },
    "notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    },
    "title_length": {
      "description": "Titles outside this band get a title_length warning.",
      "additionalProperties": false,
      "properties": {
        "max_chars": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "min_chars": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "min_chars",
        "max_chars"
      ],
      "type": "object"
    },
    "verified": {
      "type": "boolean"
    },
    "verified_on": {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title_length",
    "basis",
    "verified"
  ],
  "type": "object"
}
