{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:tone-rules",
  "title": "ToneRules",
  "description": "research-specs/tones.yaml: tone presets (pacing, transitions, sound density, bed level) as data.",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "enum": [
        "heuristic",
        "measured"
      ],
      "type": "string"
    },
    "default": {
      "description": "Preset used when nothing clearly fits.",
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "const": "tones",
      "type": "string"
    },
    "notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "presets": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "acceptance": {
            "description": "Acceptance hints for the tone, under the template's and the brief's.",
            "additionalProperties": false,
            "properties": {
              "hold_ms": {
                "description": "At least one deliberate hold this long, so change feels earned (e.g. 400).",
                "maximum": 5000,
                "minimum": 0,
                "type": "integer"
              },
              "loop": {
                "description": "The piece must loop seamlessly (last frame flows into the first).",
                "type": "boolean"
              },
              "max_frozen_pct": {
                "description": "Most of the runtime that may be frozen, in percent (default 15).",
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              "max_static_sec": {
                "description": "Longest allowed stretch with no visual change.",
                "exclusiveMinimum": 0,
                "maximum": 60,
                "type": "number"
              },
              "min_changes_per_sec": {
                "description": "Big visual changes per second the render must reach (motion density).",
                "maximum": 10,
                "minimum": 0,
                "type": "number"
              },
              "min_moving_pct": {
                "description": "Least share of the runtime, in percent, where the picture is moving at all (smooth motion and crossfades count; a still frame does not).",
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "avg_shot_sec": {
            "exclusiveMinimum": 0,
            "maximum": 30,
            "type": "number"
          },
          "bed_db": {
            "description": "Music bed level under the mix (the engine default is -18).",
            "maximum": 0,
            "minimum": -40,
            "type": "number"
          },
          "caption_case": {
            "enum": [
              "as_written",
              "upper",
              "lower"
            ],
            "type": "string"
          },
          "feel": {
            "description": "One line: how it should feel.",
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "scenes": {
            "description": "Scene count for a 15–25 s piece.",
            "additionalProperties": false,
            "properties": {
              "max": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "min": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "min",
              "max"
            ],
            "type": "object"
          },
          "sfx": {
            "enum": [
              "none",
              "sparse",
              "moderate",
              "dense"
            ],
            "type": "string"
          },
          "transitions": {
            "description": "Transitions that fit; the first is the default.",
            "items": {
              "enum": [
                "cut",
                "crossfade",
                "fade_black",
                "slide",
                "zoom",
                "whip"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "label",
          "feel",
          "scenes",
          "avg_shot_sec",
          "transitions",
          "sfx",
          "bed_db"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "type": "string"
      },
      "type": "object"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "default",
    "presets",
    "basis",
    "verified"
  ],
  "type": "object"
}
