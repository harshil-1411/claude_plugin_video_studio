{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:render-manifest",
  "title": "RenderManifest",
  "description": "Exactly what happened: per-scene provider/model, prompts, seeds, task ids, hashes, cost, timestamps, retries, outputs, QA and tool versions.",
  "additionalProperties": false,
  "properties": {
    "c2pa": {
      "description": "C2PA content credentials written at export.",
      "additionalProperties": false,
      "properties": {
        "ai_generated": {
          "description": "Whether the manifest declares AI-generated content (trainedAlgorithmicMedia).",
          "type": "boolean"
        },
        "assertions": {
          "description": "Assertion labels written, e.g. c2pa.actions, stds.schema-org.CreativeWork.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "certificate": {
          "description": "test: the tool's built-in test certificate (not trusted by validators); user: the user's own certificate.",
          "enum": [
            "test",
            "user"
          ],
          "type": "string"
        },
        "claim_generator": {
          "type": "string"
        },
        "signed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "tool": {
          "description": "Signer, e.g. c2patool 0.26.68.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "certificate",
        "claim_generator",
        "assertions",
        "signed",
        "ai_generated"
      ],
      "type": "object"
    },
    "captions": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "description": "Region the burned-in captions occupy, in output pixels, for lint.",
          "additionalProperties": false,
          "properties": {
            "h": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "w": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "y": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        },
        "burn_in": {
          "type": "boolean"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "json",
                  "srt",
                  "vtt",
                  "ass",
                  "html"
                ],
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "format",
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "max_lines": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "preset": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
          "type": "string"
        },
        "sound_events": {
          "description": "Sound-event cues ([music], sfx captions, [ambient sound]) in the captions.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "preset",
        "burn_in",
        "files"
      ],
      "type": "object"
    },
    "content_ir_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "cover": {
      "description": "The compiled cover and where its headline landed, for lint.",
      "additionalProperties": false,
      "properties": {
        "at_ms": {
          "description": "Video time of the frame the cover was composed from.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "crops": {
          "description": "Regions of the cover that platforms crop to (e.g. a centre square); the headline must fit inside each.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                "type": "string"
              },
              "rect": {
                "additionalProperties": false,
                "properties": {
                  "h": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "w": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "x": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "y": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "type": "object"
              },
              "targets": {
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "id",
              "targets",
              "rect"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "headline_box": {
          "description": "One text block a renderer drew.",
          "additionalProperties": false,
          "properties": {
            "background": {
              "description": "Colour behind the text #RRGGBB, for contrast checks.",
              "type": "string"
            },
            "color": {
              "description": "Text colour #RRGGBB.",
              "type": "string"
            },
            "font_px": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "rect": {
              "description": "Box the text was fitted into, in output pixels.",
              "additionalProperties": false,
              "properties": {
                "h": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "w": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "x": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                "y": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "type": "object"
            },
            "role": {
              "description": "hook, headline, caption and cta overflow is an error in lint; decorative is a warning.",
              "enum": [
                "hook",
                "headline",
                "body",
                "label",
                "code",
                "caption",
                "cta",
                "decorative"
              ],
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "truncated": {
              "description": "fitText could not fit the text without cutting it.",
              "type": "boolean"
            }
          },
          "required": [
            "role",
            "text",
            "rect",
            "font_px",
            "truncated"
          ],
          "type": "object"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "square_preview": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "at_ms",
        "crops"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "music": {
      "description": "The music bed mixed into the audio, with its rights.",
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "`bundled:<id>` or the project-relative path from spec.audio.music.file.",
          "minLength": 1,
          "type": "string"
        },
        "license": {
          "description": "Rights for an audio file; recorded in the manifest, video.lock and provenance.",
          "additionalProperties": false,
          "properties": {
            "attribution": {
              "description": "Credit line to show or post, when the licence requires one.",
              "type": "string"
            },
            "id": {
              "description": "SPDX id (e.g. CC0-1.0, CC-BY-4.0) or user-owned / licensed.",
              "minLength": 1,
              "type": "string"
            },
            "source": {
              "description": "Where the track came from (URL or description).",
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "type": "object"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "c2pa": {
            "description": "True when the file carries a signed C2PA manifest.",
            "type": "boolean"
          },
          "duration_sec": {
            "minimum": 0,
            "type": "number"
          },
          "height": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "kind": {
            "enum": [
              "final",
              "clean_master",
              "captions",
              "thumbnail",
              "social_copy",
              "provenance",
              "manifest",
              "post",
              "qa",
              "spec",
              "lock",
              "other"
            ],
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "target": {
            "description": "Platform contract id for files in dist/<target>/; absent for shared files.",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "transcoded": {
            "description": "True when the file was re-encoded to fit the target's envelope rather than copied.",
            "type": "boolean"
          },
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "qa": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "scene_id": {
                "pattern": "^s\\d{2,}$",
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "warn",
                  "fail"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "report_path": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "type": "object"
    },
    "renders": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "cost_usd": {
            "minimum": 0,
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "finished_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
