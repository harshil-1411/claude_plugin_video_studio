          },
          "prompt": {
            "type": "string"
          },
          "provider": {
            "description": "Adapter id that produced the output, e.g. `mock` or `hyperframes-local`.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "renderer_version": {
            "description": "Version of the local renderer or adapter that produced the output.",
            "type": "string"
          },
          "request_hash": {
            "description": "Canonical-JSON hash of the generation request; the idempotency key.",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "scene_id": {
            "pattern": "^s\\d{2,}$",
            "type": "string"
          },
          "seed": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "submitted",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "cached"
            ],
            "type": "string"
          },
          "task_id": {
            "description": "Provider task/job id, persisted as soon as it is known.",
            "type": "string"
          },
          "text_boxes": {
            "description": "Text the renderer drew, for lint.",
            "items": {
              "description": "One text block a renderer drew.",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "description": "Colour behind the text #RRGGBB, for contrast checks.",
                  "type": "string"
                },
                "color": {
                  "description": "Text colour #RRGGBB.",
                  "type": "string"
                },
                "font_px": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "rect": {
                  "description": "Box the text was fitted into, in output pixels.",
                  "additionalProperties": false,
                  "properties": {
                    "h": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "w": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "x": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "y": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
