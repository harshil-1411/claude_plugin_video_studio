{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:video-spec",
  "title": "VideoSpec",
  "description": "What we are making: a provider-independent scene graph that declares capability requirements, never model names.",
  "additionalProperties": false,
  "properties": {
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5"
      ],
      "type": "string"
    },
    "audience": {
      "minLength": 1,
      "type": "string"
    },
    "audio": {
      "description": "Audio beds beyond the voice.",
      "additionalProperties": false,
      "properties": {
        "beat_sync": {
          "description": "Snap scene cuts to beats detected in the music bed (default tolerance 250 ms).",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tolerance_ms": {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        },
        "music": {
          "description": "Background music mixed under the voice.",
          "additionalProperties": false,
          "properties": {
            "duck_db": {
              "description": "Extra attenuation while speech plays. Default -10 dB; ignored with voice.mode none.",
              "maximum": 0,
              "minimum": -40,
              "type": "number"
            },
            "fade_in_ms": {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            "fade_out_ms": {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            "file": {
              "description": "`bundled:<id>` (music/ in the plugin) or a path relative to the project folder.",
              "minLength": 1,
              "type": "string"
            },
            "license": {
              "description": "Required for user files; bundled tracks carry their own.",
              "additionalProperties": false,
              "properties": {
                "attribution": {
                  "description": "Credit line to show or post, when the licence requires one.",
                  "type": "string"
                },
                "id": {
                  "description": "SPDX id (e.g. CC0-1.0, CC-BY-4.0) or user-owned / licensed.",
                  "minLength": 1,
                  "type": "string"
                },
                "source": {
                  "description": "Where the track came from (URL or description).",
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            "loop": {
              "description": "Loop the track to cover the video (default true).",
              "type": "boolean"
            },
            "start_sec": {
              "description": "Offset into the track.",
              "minimum": 0,
              "type": "number"
            },
            "volume_db": {
              "description": "Bed level before ducking. Default -18 dB.",
              "maximum": 0,
              "minimum": -60,
              "type": "number"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "brand_profile": {
      "description": "Brand profile reference, e.g. `acme@3`.",
      "type": "string"
    },
    "brief_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "captions": {
      "additionalProperties": false,
      "properties": {
        "burn_in": {
          "type": "boolean"
        },
        "position": {
          "description": "Manual caption placement. Omit to let the caption engine place captions in the platforms' caption zone.",
          "additionalProperties": false,
          "properties": {
            "y": {
              "description": "Vertical centre of the caption block as a fraction of frame height.",
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "y"
          ],
          "type": "object"
        },
        "preset": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
          "type": "string"
        },
        "sound_events": {
          "description": "Caption non-speech sound too (accessibility): [music] while only music plays, sfx captions, [ambient sound] for native clips without speech. Default true when captions are burned in.",
          "type": "boolean"
        }
      },
      "required": [
        "preset",
        "burn_in"
      ],
      "type": "object"
    },
    "content_ir_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "cover": {
      "description": "Cover (thumbnail) text and focal frame.",
      "additionalProperties": false,
      "properties": {
        "focal_time_sec": {
          "description": "Video time of the frame the cover is composed from (TikTok uses it as the cover timestamp).",
          "minimum": 0,
          "type": "number"
        },
        "headline": {
          "description": "Cover/thumbnail text; separate from on-screen text, captions and post captions.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "headline",
        "focal_time_sec"
      ],
      "type": "object"
    },
    "goal": {
      "enum": [
        "explain",
        "launch",
        "educate",
        "promote",
        "announce",
        "case_study"
      ],
      "type": "string"
    },
    "grounding": {
      "enum": [
        "strict",
        "loose",
        "off"
      ],
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "type": "string"
    },
    "master": {
      "description": "Production master canvas every target is compiled from. Defaults to 1080 px on the short side at 30 fps.",
      "additionalProperties": false,
      "properties": {
        "fps": {
          "anyOf": [
            {
              "const": 24,
              "type": "number"
            },
            {
              "const": 30,
              "type": "number"
            },
            {
              "const": 60,
              "type": "number"
            }
          ]
        },
        "height": {
          "maximum": 7680,
          "minimum": 2,
          "type": "integer"
        },
        "width": {
          "maximum": 7680,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "type": "object"
    },
    "platform": {
      "description": "Primary platform; with `aspect_ratio` it defines the primary target.",
      "enum": [
        "instagram_reels",
        "tiktok",
        "youtube_shorts",
        "youtube",
        "linkedin",
        "x",
        "generic"
      ],
      "type": "string"
    },
    "policy_profile": {
      "type": "string"
    },
    "publish": {
      "description": "Post copy keyed by target id.",
      "additionalProperties": {
        "description": "Per-target post copy.",
        "additionalProperties": false,
        "properties": {
          "ai_disclosure": {
            "description": "Mark the post as AI-generated where the platform supports it.",
            "type": "boolean"
          },
          "hashtags": {
            "items": {
              "pattern": "^#[\\p{L}\\p{N}_]+$",
              "type": "string"
            },
            "type": "array"
          },
          "post_caption": {
            "description": "Text posted with the video on the platform; separate from speech captions.",
            "type": "string"
          }
        },
        "required": [
          "post_caption"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "object"
    },
    "scenes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "audio": {
            "description": "What this scene sounds like (footage scenes).",
            "additionalProperties": false,
            "properties": {
              "crossfade_ms": {
                "description": "Audio crossfade into this scene.",
                "maximum": 3000,
                "minimum": 0,
                "type": "integer"
              },
              "mode": {
                "description": "native: the clip's own sound; music: the bed only; mute: silence; mix: clip sound under the bed.",
                "enum": [
                  "native",
                  "music",
                  "mute",
                  "mix"
                ],
                "type": "string"
              },
              "native_db": {
                "description": "Gain on the clip's sound (default 0).",
                "maximum": 12,
                "minimum": -60,
                "type": "number"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          },
          "claim_refs": {
            "description": "Evidence source_refs or ContentIR claim ids backing this scene.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "deterministic": {
            "description": "Deterministic (template-rendered) content for this scene.",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "typography",
                  "code",
                  "chart",
                  "diagram",
                  "screenshot",
                  "comparison",
                  "cta",
                  "end_card",
                  "quote",
                  "stat",
                  "timeline",
                  "split_screen",
                  "lower_third",
                  "kinetic_text",
                  "map"
                ],
                "type": "string"
              },
              "props": {
                "description": "Template props passed verbatim to the deterministic renderer.",
                "additionalProperties": {},
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "kind",
              "props"
            ],
            "type": "object"
          },
          "duration_sec": {
            "exclusiveMinimum": 0,
            "maximum": 120,
            "type": "number"
          },
          "footage": {
            "description": "Real footage for user_asset / screen_capture scenes; a deterministic block, if any, is drawn over it.",
            "additionalProperties": false,
            "properties": {
              "asset": {
                "description": "ContentIR asset id of a video (or image) the user supplied or recorded.",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                "type": "string"
              },
              "fit": {
                "description": "How the clip fills the frame: crop (default), letterbox, or a blurred copy behind it.",
                "enum": [
                  "cover",
                  "contain",
                  "blur_pad"
                ],
                "type": "string"
              },
              "focus": {
                "description": "Crop centre for cover (0–1).",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "y": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "type": "object"
              },
              "in_sec": {
                "description": "Start inside the asset.",
                "minimum": 0,
                "type": "number"
              },
              "loop": {
                "description": "Loop a clip shorter than the scene (default: hold the last frame).",
                "type": "boolean"
              },
              "out_sec": {
                "description": "End inside the asset; default in_sec + scene duration.",
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "redact": {
                "description": "Regions blurred or boxed in the source frame before it is fitted.",
                "items": {
                  "description": "A region of the footage to make unreadable (private data, faces, inboxes).",
                  "additionalProperties": false,
                  "properties": {
                    "from_sec": {
                      "description": "Asset time the region starts (default: always).",
                      "minimum": 0,
                      "type": "number"
                    },
                    "h": {
                      "exclusiveMinimum": 0,
                      "maximum": 1,
                      "type": "number"
                    },
                    "label": {
                      "description": "What is hidden, for the render record, e.g. 'customer inbox'.",
                      "type": "string"
                    },
                    "mode": {
                      "description": "blur (default, heavy) or an opaque box.",
                      "enum": [
                        "blur",
                        "box"
                      ],
                      "type": "string"
                    },
                    "to_sec": {
                      "description": "Asset time the region ends (default: always).",
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    "w": {
                      "exclusiveMinimum": 0,
                      "maximum": 1,
                      "type": "number"
                    },
                    "x": {
                      "description": "Left edge, as a fraction of the SOURCE frame width.",
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "y": {
                      "description": "Top edge, as a fraction of the source frame height.",
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "type": "object"
                },
                "maxItems": 12,
                "type": "array"
              },
              "speed": {
                "description": "Playback rate (1 = normal).",
                "maximum": 4,
                "minimum": 0.25,
                "type": "number"
              }
            },
            "required": [
              "asset",
              "in_sec"
            ],
            "type": "object"
          },
          "id": {
            "pattern": "^s\\d{2,}$",
            "type": "string"
          },
          "motion": {
            "description": "Camera-like motion of the whole scene frame.",
            "additionalProperties": false,
            "properties": {
              "intensity": {
                "description": "How far the move goes (default normal).",
                "enum": [
                  "subtle",
                  "normal",
                  "strong"
                ],
                "type": "string"
              },
              "pattern": {
                "enum": [
                  "push_in",
                  "pull_out",
                  "punch",
                  "reveal",
                  "drift",
                  "hold"
                ],
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ],
            "type": "object"
          },
          "on_screen_text": {
            "type": "string"
          },
          "purpose": {
            "enum": [
              "hook",
              "problem",
              "context",
              "point",
              "proof",
              "demo",
              "payoff",
              "cta",
              "end_card",
              "question",
              "contrarian_claim",
              "story",
              "step",
              "comparison",
              "reveal",
              "objection",
              "testimonial",
              "result",
              "loop_back"
            ],
            "type": "string"
          },
          "sfx": {
            "items": {
              "description": "A one-shot sound effect.",
              "additionalProperties": false,
              "properties": {
                "at_sec": {
                  "description": "Offset inside the scene.",
                  "minimum": 0,
                  "type": "number"
                },
                "caption": {
                  "description": "Sound-event caption shown while it plays, e.g. \"[applause]\" (accessibility).",
                  "type": "string"
                },
                "file": {
                  "description": "Project-relative audio file.",
                  "minLength": 1,
                  "type": "string"
                },
                "license": {
                  "description": "Rights for an audio file; recorded in the manifest, video.lock and provenance.",
                  "additionalProperties": false,
                  "properties": {
                    "attribution": {
                      "description": "Credit line to show or post, when the licence requires one.",
                      "type": "string"
                    },
                    "id": {
                      "description": "SPDX id (e.g. CC0-1.0, CC-BY-4.0) or user-owned / licensed.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "source": {
                      "description": "Where the track came from (URL or description).",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "type": "object"
                },
                "volume_db": {
                  "maximum": 6,
                  "minimum": -60,
                  "type": "number"
                }
              },
              "required": [
                "file",
                "at_sec"
              ],
              "type": "object"
            },
            "maxItems": 8,
            "type": "array"
          },
          "transition": {
            "enum": [
              "cut",
              "crossfade",
              "fade_black",
              "slide",
              "zoom",
              "whip"
            ],
            "type": "string"
          },
          "visual_requirements": {
            "description": "Capability requirements for the router. Never names a provider or model.",
            "additionalProperties": false,
            "properties": {
              "audio_generation": {
                "enum": [
                  "required",
                  "optional",
                  "none"
                ],
                "type": "string"
              },
              "camera": {
                "type": "string"
              },
              "character_reference": {
                "enum": [
                  "required",
                  "optional",
                  "none"
                ],
                "type": "string"
              },
              "continuity_refs": {
                "description": "Scene or asset ids this scene must stay visually consistent with.",
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                  "type": "string"
                },
                "type": "array"
              },
              "data_policy": {
                "enum": [
                  "external-ok",
                  "local-only"
                ],
                "type": "string"
              },
              "max_cost_usd": {
                "minimum": 0,
                "type": "number"
              },
              "modality": {
                "enum": [
                  "video",
                  "image",
                  "none"
                ],
                "type": "string"
              },
              "preference": {
                "description": "Ordered routing priorities.",
                "items": {
                  "enum": [
                    "continuity",
                    "quality",
                    "speed",
                    "cost"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "realism": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "style": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            },
            "required": [
              "continuity_refs"
            ],
            "type": "object"
          },
          "visual_strategy": {
            "enum": [
              "motion_graphic",
              "generated_video",
              "avatar",
              "screen_capture",
              "user_asset",
              "stock"
            ],
            "type": "string"
          },
          "voiceover": {
            "description": "Narration for this scene; empty string for silent scenes.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "duration_sec",
          "purpose",
          "voiceover",
          "visual_strategy",
          "visual_requirements",
          "claim_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    },
    "style": {
      "description": "Style pack id: styles/<id>.yaml (look and motion). Brand colours and fonts override it.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "target_duration_sec": {
      "exclusiveMinimum": 0,
      "maximum": 600,
      "type": "number"
    },
    "targets": {
      "description": "Platform contract ids to compile for. Defaults to the primary platform's contract.",
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "voice": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "narrated: scenes carry voiceover (default). none: no speech; timing comes from scene durations and on-screen text, usually over a music bed. native: the speech is in the footage (talking head, interview); captions come from the asset transcripts.",
          "enum": [
            "narrated",
            "none",
            "native"
          ],
          "type": "string"
        },
        "provider_preference": {
          "description": "Preferred TTS providers in order; the router may override on policy.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "type": "array"
        },
        "rate_wpm": {
          "description": "Speaking rate in words per minute for system TTS (default 160; 145–165 sounds natural for explainers).",
          "maximum": 230,
          "minimum": 110,
          "type": "integer"
        },
        "style": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "goal",
    "audience",
    "platform",
    "aspect_ratio",
    "target_duration_sec",
    "language",
    "grounding",
    "voice",
    "captions",
    "scenes"
  ],
  "type": "object"
}
