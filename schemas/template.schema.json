{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:template",
  "title": "Template",
  "description": "A story template as data: beat structure with duration shares, pacing, caption preset, preferred hook mechanisms and rules.",
  "additionalProperties": false,
  "properties": {
    "beats": {
      "items": {
        "description": "One beat of a template's story structure; becomes one scene when scaffolded.",
        "additionalProperties": false,
        "properties": {
          "guidance": {
            "description": "One or two sentences on what this beat must do.",
            "minLength": 1,
            "type": "string"
          },
          "optional": {
            "description": "Beat may be dropped for short cuts; remaining shares are renormalized.",
            "type": "boolean"
          },
          "purpose": {
            "enum": [
              "hook",
              "problem",
              "context",
              "point",
              "proof",
              "demo",
              "payoff",
              "cta",
              "end_card",
              "question",
              "contrarian_claim",
              "story",
              "step",
              "comparison",
              "reveal",
              "objection",
              "testimonial",
              "result",
              "loop_back"
            ],
            "type": "string"
          },
          "share": {
            "description": "Fraction of the total duration for this beat; all beats sum to 1 (±0.01).",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "suggested_deterministic_kind": {
            "enum": [
              "typography",
              "code",
              "chart",
              "diagram",
              "screenshot",
              "comparison",
              "cta",
              "end_card",
              "quote",
              "stat",
              "timeline",
              "split_screen",
              "lower_third",
              "kinetic_text",
              "map",
              "motion"
            ],
            "type": "string"
          },
          "suggested_visual_strategy": {
            "enum": [
              "motion_graphic",
              "generated_video",
              "avatar",
              "screen_capture",
              "user_asset",
              "stock"
            ],
            "type": "string"
          }
        },
        "required": [
          "purpose",
          "share",
          "guidance",
          "suggested_visual_strategy"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "caption_preset": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "default_aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5"
      ],
      "type": "string"
    },
    "default_duration_sec": {
      "exclusiveMinimum": 0,
      "maximum": 600,
      "type": "number"
    },
    "default_music": {
      "description": "Music bed the scaffold selects, e.g. bundled:lofi or synth:<preset>.",
      "type": "string"
    },
    "default_style": {
      "description": "Style pack the scaffold selects unless the user picks one.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "duration_range": {
      "additionalProperties": false,
      "properties": {
        "max_sec": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "type": "number"
        },
        "min_sec": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "min_sec",
        "max_sec"
      ],
      "type": "object"
    },
    "goals": {
      "items": {
        "enum": [
          "explain",
          "launch",
          "educate",
          "promote",
          "announce",
          "case_study"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "hook_mechanisms": {
      "description": "Preferred hook mechanisms, best first.",
      "items": {
        "enum": [
          "curiosity_gap",
          "contrarian",
          "statistic",
          "question",
          "pain_point",
          "promise",
          "story",
          "demo",
          "pattern_interrupt",
          "before_after",
          "mistake",
          "contrarian_claim"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "inputs": {
      "description": "Inputs to ask for first; required ones block planning until answered or defaulted.",
      "items": {
        "description": "One input a template needs from the user.",
        "additionalProperties": false,
        "properties": {
          "default": {
            "description": "What the plan uses (and records as an assumption) when the user skips the question.",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "kind": {
            "description": "text: a short answer; asset: an image or clip to ingest; choice: one of `options`; file: any project file (e.g. a licensed track).",
            "enum": [
              "text",
              "asset",
              "choice",
              "file"
            ],
            "type": "string"
          },
          "options": {
            "description": "The choices, for kind choice.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 2,
            "type": "array"
          },
          "prompt": {
            "description": "The question to ask, in plain words.",
            "minLength": 1,
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "prompt",
          "kind",
          "required"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "pacing": {
      "additionalProperties": false,
      "properties": {
        "avg_shot_sec": {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "type": "number"
        },
        "max_frozen_pct": {
          "description": "Most of the runtime that may be frozen, in percent; the brief's acceptance overrides it.",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "max_words_per_sec": {
          "exclusiveMinimum": 0,
          "maximum": 6,
          "type": "number"
        },
        "min_changes_per_sec": {
          "description": "Motion density this format needs; the brief's acceptance overrides it.",
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "avg_shot_sec",
        "max_words_per_sec"
      ],
      "type": "object"
    },
    "platforms": {
      "items": {
        "enum": [
          "instagram_reels",
          "tiktok",
          "youtube_shorts",
          "youtube",
          "linkedin",
          "x",
          "generic"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "rules": {
      "description": "Story rules the plan must follow, e.g. one idea per scene.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    },
    "voice_mode": {
      "description": "Archetypes without speech (e.g. text-over-music) set none.",
      "enum": [
        "narrated",
        "none",
        "native"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "goals",
    "platforms",
    "default_duration_sec",
    "duration_range",
    "pacing",
    "caption_preset",
    "beats",
    "hook_mechanisms",
    "rules"
  ],
  "type": "object"
}
