{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:content-ir",
  "title": "ContentIR",
  "description": "What the user gave us: normalized source text, evidence spans with stable source_refs, entities, claims, extracted assets and an ingestion security label.",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio"
            ],
            "type": "string"
          },
          "media": {
            "description": "For video and audio assets.",
            "additionalProperties": false,
            "properties": {
              "duration_sec": {
                "minimum": 0,
                "type": "number"
              },
              "fps": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "has_audio": {
                "type": "boolean"
              },
              "has_video": {
                "type": "boolean"
              },
              "height": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "loudness_lufs": {
                "type": "number"
              },
              "shots": {
                "description": "Shot boundaries from scene detection.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "end_sec": {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    "keyframe": {
                      "description": "Image asset id of a representative frame.",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                      "type": "string"
                    },
                    "start_sec": {
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "start_sec",
                    "end_sec"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "transcript": {
                "description": "Timed transcript of the asset's speech.",
                "additionalProperties": false,
                "properties": {
                  "language": {
                    "type": "string"
                  },
                  "model": {
                    "description": "ASR model, e.g. ggml-base.en.",
                    "type": "string"
                  },
                  "path": {
                    "description": "Project-relative JSON file with timed words: [{word, start_ms, end_ms}].",
                    "minLength": 1,
                    "type": "string"
                  },
                  "source": {
                    "description": "whisper.cpp (local ASR) or a caption file the user supplied.",
                    "enum": [
                      "whisper",
                      "srt",
                      "vtt"
                    ],
                    "type": "string"
                  },
                  "words": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "path",
                  "source",
                  "words"
                ],
                "type": "object"
              },
              "width": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              }
            },
            "required": [
              "duration_sec",
              "has_video",
              "has_audio"
            ],
            "type": "object"
          },
          "path": {
            "description": "Project-relative path of the extracted asset.",
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "source_ref": {
            "pattern": "^(?:text|markdown|url|pdf|docx|pptx|repo|video|audio):\\S+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_refs": {
            "description": "Evidence spans supporting this claim.",
            "items": {
              "pattern": "^(?:text|markdown|url|pdf|docx|pptx|repo|video|audio):\\S+$",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "quantitative",
              "qualitative"
            ],
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "evidence_refs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "classification": {
      "description": "Ingestion security label; drives policy routing.",
      "additionalProperties": false,
      "properties": {
        "contains_likeness": {
          "type": "boolean"
        },
        "contains_pii": {
          "type": "boolean"
        },
        "contains_secrets": {
          "type": "boolean"
        },
        "data_class": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contains_secrets",
        "contains_pii",
        "contains_likeness",
        "data_class",
        "notes"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "evidence_refs": {
            "items": {
              "pattern": "^(?:text|markdown|url|pdf|docx|pptx|repo|video|audio):\\S+$",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "product",
              "organization",
              "person",
              "technology",
              "concept",
              "place",
              "metric",
              "other"
            ],
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "locator": {
            "description": "Machine-readable position of an evidence span inside its source.",
            "additionalProperties": false,
            "properties": {
              "char_end": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "char_start": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "line_end": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "line_start": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "page": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "selector": {
                "description": "CSS selector or heading anchor for URL/markdown sources.",
                "type": "string"
              },
              "slide": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "time_end_sec": {
                "minimum": 0,
                "type": "number"
              },
              "time_start_sec": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "ref": {
            "description": "Stable source_ref, unique within the ContentIR.",
            "pattern": "^(?:text|markdown|url|pdf|docx|pptx|repo|video|audio):\\S+$",
            "type": "string"
          },
          "source_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "text": {
            "description": "Verbatim excerpt from the source.",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "source_id",
          "text",
          "locator"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    },
    "sections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "source_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "text": {
            "description": "Normalized plain text of the section.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_id",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "markdown",
              "url",
              "pdf",
              "docx",
              "pptx",
              "repo",
              "video",
              "audio"
            ],
            "type": "string"
          },
          "sha256": {
            "description": "Hash of the raw source bytes as ingested.",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "uri": {
            "description": "Original location: file path, URL or repo path.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "uri",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "warnings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "source_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "sources",
    "sections",
    "evidence",
    "entities",
    "claims",
    "assets",
    "classification",
    "warnings"
  ],
  "type": "object"
}
