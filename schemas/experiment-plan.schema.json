{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-studio:schema:experiment-plan",
  "title": "ExperimentPlan",
  "description": "project/variants.json: hypothesis, hook variants and cover variants for an A/B experiment.",
  "additionalProperties": false,
  "properties": {
    "covers": {
      "description": "Omit to keep the base spec's cover for every variant.",
      "items": {
        "description": "One cover to test.",
        "additionalProperties": false,
        "properties": {
          "cover": {
            "description": "Cover (thumbnail) text and focal frame.",
            "additionalProperties": false,
            "properties": {
              "focal_time_sec": {
                "description": "Video time of the frame the cover is composed from (TikTok uses it as the cover timestamp).",
                "minimum": 0,
                "type": "number"
              },
              "headline": {
                "description": "Cover/thumbnail text; separate from on-screen text, captions and post captions.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "headline",
              "focal_time_sec"
            ],
            "type": "object"
          },
          "id": {
            "description": "Short id, e.g. c1, bold.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "cover"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
    },
    "hooks": {
      "items": {
        "description": "One hook to test.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Short id, e.g. h1, question, stat.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
            "type": "string"
          },
          "label": {
            "description": "What this hook tries, e.g. 'question hook'.",
            "type": "string"
          },
          "scene": {
            "description": "Replacement for the base spec's hook scene (same id is not required; it takes the hook's place).",
            "additionalProperties": false,
            "properties": {
              "audio": {
                "description": "What this scene sounds like (footage scenes).",
                "additionalProperties": false,
                "properties": {
                  "crossfade_ms": {
                    "description": "Audio crossfade into this scene.",
                    "maximum": 3000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "mode": {
                    "description": "native: the clip's own sound; music: the bed only; mute: silence; mix: clip sound under the bed.",
                    "enum": [
                      "native",
                      "music",
                      "mute",
                      "mix"
                    ],
                    "type": "string"
                  },
                  "native_db": {
                    "description": "Gain on the clip's sound (default 0).",
                    "maximum": 12,
                    "minimum": -60,
                    "type": "number"
                  }
                },
                "required": [
                  "mode"
                ],
                "type": "object"
              },
              "claim_refs": {
                "description": "Evidence source_refs or ContentIR claim ids backing this scene.",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "cues": {
                "description": "Word cues: each reveal item of the deterministic graphic appears as its word is spoken. Items without a cue keep the default stagger, never ahead of an earlier cue.",
                "items": {
                  "description": "Lands one reveal item of the scene's graphic on a spoken word.",
                  "additionalProperties": false,
                  "properties": {
                    "item": {
                      "description": "Reveal item it drives (see cueItems for each kind); default: the item after the previous cue's, starting at 0.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "occurrence": {
                      "description": "Which occurrence of the word in the scene's speech (default 1).",
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "word": {
                      "description": "A word or short phrase of this scene's speech (voiceover, or the footage transcript in voice.mode native). Matched case-insensitively, ignoring punctuation.",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "word"
                  ],
                  "type": "object"
                },
                "maxItems": 12,
                "type": "array"
              },
              "deterministic": {
                "description": "Deterministic (template-rendered) content for this scene.",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "typography",
                      "code",
                      "chart",
                      "diagram",
                      "screenshot",
                      "comparison",
                      "cta",
                      "end_card",
                      "quote",
                      "stat",
                      "timeline",
                      "split_screen",
                      "lower_third",
                      "kinetic_text",
                      "map"
                    ],
                    "type": "string"
                  },
                  "props": {
                    "description": "Template props passed verbatim to the deterministic renderer.",
                    "additionalProperties": {},
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "kind",
                  "props"
                ],
                "type": "object"
              },
              "duration_sec": {
                "exclusiveMinimum": 0,
                "maximum": 120,
                "type": "number"
              },
              "footage": {
                "description": "Real footage for user_asset / screen_capture scenes; a deterministic block, if any, is drawn over it.",
                "additionalProperties": false,
                "properties": {
                  "asset": {
                    "description": "ContentIR asset id of a video (or image) the user supplied or recorded.",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                    "type": "string"
                  },
                  "cutaway": {
                    "description": "Cut away from the footage: the scene's deterministic graphic fills the frame while the clip's sound and transcript words keep playing (B-roll over a talking head).",
                    "type": "boolean"
                  },
                  "fit": {
                    "description": "How the clip fills the frame: crop (default), letterbox, or a blurred copy behind it.",
                    "enum": [
                      "cover",
                      "contain",
                      "blur_pad"
                    ],
                    "type": "string"
                  },
                  "focus": {
                    "description": "Crop centre for cover (0–1).",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      },
                      "y": {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": "object"
                  },
                  "in_sec": {
                    "description": "Start inside the asset.",
                    "minimum": 0,
                    "type": "number"
                  },
                  "loop": {
                    "description": "Loop a clip shorter than the scene (default: hold the last frame).",
                    "type": "boolean"
                  },
                  "out_sec": {
                    "description": "End inside the asset; default in_sec + scene duration.",
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "redact": {
                    "description": "Regions blurred or boxed in the source frame before it is fitted.",
                    "items": {
                      "description": "A region of the footage to make unreadable (private data, faces, inboxes).",
                      "additionalProperties": false,
                      "properties": {
                        "from_sec": {
                          "description": "Asset time the region starts (default: always).",
                          "minimum": 0,
                          "type": "number"
                        },
                        "h": {
                          "exclusiveMinimum": 0,
                          "maximum": 1,
                          "type": "number"
                        },
                        "label": {
                          "description": "What is hidden, for the render record, e.g. 'customer inbox'.",
                          "type": "string"
                        },
                        "mode": {
                          "description": "blur (default, heavy) or an opaque box.",
                          "enum": [
                            "blur",
                            "box"
                          ],
                          "type": "string"
                        },
                        "to_sec": {
                          "description": "Asset time the region ends (default: always).",
                          "exclusiveMinimum": 0,
                          "type": "number"
                        },
                        "w": {
                          "exclusiveMinimum": 0,
                          "maximum": 1,
                          "type": "number"
                        },
                        "x": {
                          "description": "Left edge, as a fraction of the SOURCE frame width.",
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number"
                        },
                        "y": {
                          "description": "Top edge, as a fraction of the source frame height.",
                          "maximum": 1,
                          "minimum": 0,
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "type": "object"
                    },
                    "maxItems": 12,
                    "type": "array"
                  },
                  "speed": {
                    "description": "Playback rate (1 = normal).",
                    "maximum": 4,
                    "minimum": 0.25,
                    "type": "number"
                  }
                },
                "required": [
                  "asset",
                  "in_sec"
                ],
                "type": "object"
              },
              "id": {
                "pattern": "^s\\d{2,}$",
                "type": "string"
              },
              "motion": {
                "description": "Camera-like motion of the whole scene frame.",
                "additionalProperties": false,
                "properties": {
                  "intensity": {
                    "description": "How far the move goes (default normal).",
                    "enum": [
                      "subtle",
                      "normal",
                      "strong"
                    ],
                    "type": "string"
                  },
                  "pattern": {
                    "enum": [
                      "push_in",
                      "pull_out",
                      "punch",
                      "reveal",
                      "drift",
                      "hold"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "pattern"
                ],
                "type": "object"
              },
              "on_screen_text": {
                "type": "string"
              },
              "purpose": {
                "enum": [
                  "hook",
                  "problem",
                  "context",
                  "point",
                  "proof",
                  "demo",
                  "payoff",
                  "cta",
                  "end_card",
                  "question",
                  "contrarian_claim",
                  "story",
                  "step",
                  "comparison",
                  "reveal",
                  "objection",
                  "testimonial",
                  "result",
                  "loop_back"
                ],
                "type": "string"
              },
              "sfx": {
                "items": {
                  "description": "A one-shot sound effect.",
                  "additionalProperties": false,
                  "properties": {
                    "at_sec": {
                      "description": "Offset inside the scene.",
                      "minimum": 0,
                      "type": "number"
                    },
                    "caption": {
                      "description": "Sound-event caption shown while it plays, e.g. \"[applause]\" (accessibility).",
                      "type": "string"
                    },
                    "file": {
                      "description": "Project-relative audio file.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "license": {
                      "description": "Rights for an audio file; recorded in the manifest, video.lock and provenance.",
                      "additionalProperties": false,
                      "properties": {
                        "attribution": {
                          "description": "Credit line to show or post, when the licence requires one.",
                          "type": "string"
                        },
                        "id": {
                          "description": "SPDX id (e.g. CC0-1.0, CC-BY-4.0) or user-owned / licensed.",
                          "minLength": 1,
                          "type": "string"
                        },
                        "source": {
                          "description": "Where the track came from (URL or description).",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "type": "object"
                    },
                    "volume_db": {
                      "maximum": 6,
                      "minimum": -60,
                      "type": "number"
                    }
                  },
                  "required": [
                    "file",
                    "at_sec"
                  ],
                  "type": "object"
                },
                "maxItems": 8,
                "type": "array"
              },
              "transition": {
                "enum": [
                  "cut",
                  "crossfade",
                  "fade_black",
                  "slide",
                  "zoom",
                  "whip"
                ],
                "type": "string"
              },
              "visual_requirements": {
                "description": "Capability requirements for the router. Never names a provider or model.",
                "additionalProperties": false,
                "properties": {
                  "audio_generation": {
                    "enum": [
                      "required",
                      "optional",
                      "none"
                    ],
                    "type": "string"
                  },
                  "camera": {
                    "type": "string"
                  },
                  "character_reference": {
                    "enum": [
                      "required",
                      "optional",
                      "none"
                    ],
                    "type": "string"
                  },
                  "continuity_refs": {
                    "description": "Scene or asset ids this scene must stay visually consistent with.",
                    "items": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "data_policy": {
                    "enum": [
                      "external-ok",
                      "local-only"
                    ],
                    "type": "string"
                  },
                  "max_cost_usd": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "modality": {
                    "enum": [
                      "video",
                      "image",
                      "none"
                    ],
                    "type": "string"
                  },
                  "preference": {
                    "description": "Ordered routing priorities.",
                    "items": {
                      "enum": [
                        "continuity",
                        "quality",
                        "speed",
                        "cost"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "realism": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ],
                    "type": "string"
                  },
                  "style": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  }
                },
                "required": [
                  "continuity_refs"
                ],
                "type": "object"
              },
              "visual_strategy": {
                "enum": [
                  "motion_graphic",
                  "generated_video",
                  "avatar",
                  "screen_capture",
                  "user_asset",
                  "stock"
                ],
                "type": "string"
              },
              "voiceover": {
                "description": "Narration for this scene; empty string for silent scenes.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "duration_sec",
              "purpose",
              "voiceover",
              "visual_strategy",
              "visual_requirements",
              "claim_refs"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "scene"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array"
    },
    "hypothesis": {
      "description": "What the experiment tests, e.g. 'a question hook beats a stat hook on 3 s retention'.",
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "description": "Experiment id, e.g. readme-hooks-1.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*$",
      "type": "string"
    },
    "metric": {
      "description": "Primary metric to compare, e.g. 3s_retention, completion_rate, saves.",
      "type": "string"
    },
    "schema_version": {
      "description": "Schema version of this document.",
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "hypothesis",
    "hooks"
  ],
  "type": "object"
}
