      },
      "visual_requirements": {
        "continuity_refs": []
      },
      "claim_refs": [
        "markdown:input/README.md#L25-L28"
      ]
    },
    {
      "id": "s05",
      "duration_sec": 4.5,
      "purpose": "point",
      "voiceover": "You get one package per platform, with the video, cover, captions and post copy.",
      "visual_strategy": "motion_graphic",
      "deterministic": {
        "kind": "stat",
        "props": {
          "value": 1,
          "unit": " package",
          "label": "per platform",
