{
  "schema_version": "1.0",
  "id": "readme-launch",
  "title": "video-studio: compile your docs into video",
  "brief_id": "brief-readme-launch",
  "goal": "launch",
  "audience": "Developers who use Claude Code and want to turn docs, posts or repos into short videos without writing video prompts",
  "platform": "youtube_shorts",
  "aspect_ratio": "9:16",
  "target_duration_sec": 40,
  "language": "en-US",
  "grounding": "strict",
  "voice": {
    "style": "calm, precise, developer to developer"
  },
  "captions": {
    "preset": "minimal",
    "burn_in": true
