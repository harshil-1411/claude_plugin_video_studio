  "scenes": [
    {
      "id": "s01",
      "duration_sec": 3.5,
      "purpose": "hook",
      "voiceover": "Stop writing video prompts. Compile your docs instead.",
      "on_screen_text": "Compile, don't prompt",
      "visual_strategy": "motion_graphic",
      "deterministic": {
        "kind": "typography",
        "props": { "lines": ["Stop writing video prompts.", "Compile your docs."], "emphasis": "Compile" }
      },
      "visual_requirements": { "continuity_refs": [] },
      "claim_refs": ["markdown:README.md#L3-L6"],
      "transition": "cut"
    },
    {
      "id": "s02",
      "duration_sec": 6,
      "purpose": "problem",
      "voiceover": "A real video is more than a clip. It needs captions, a thumbnail and its sources.",
      "on_screen_text": "More than a clip",
      "visual_strategy": "motion_graphic",
      "deterministic": {
        "kind": "comparison",
        "props": {
          "left": { "label": "A clip", "text": "MP4" },
          "right": { "label": "A package", "text": "MP4, captions, thumbnail, provenance" },
          "verdict": "ship the package"
        }
      },
      "visual_requirements": { "continuity_refs": ["s01"] },
      "claim_refs": ["markdown:README.md#L3-L6"],
      "transition": "slide"
    },
    {
      "id": "s03",
      "duration_sec": 7.5,
      "purpose": "point",
      "voiceover": "video-studio turns text, URLs, documents or repos into a finished package: MP4, captions, thumbnail, social copy and provenance.",
      "on_screen_text": "Sources in. Package out.",
      "visual_strategy": "motion_graphic",
      "deterministic": {
        "kind": "diagram",
        "props": {
          "nodes": ["text", "URLs", "documents", "repos", "video-studio", "MP4", "captions", "thumbnail", "social copy", "manifest", "provenance"],
          "edges": [
            ["text", "video-studio"], ["URLs", "video-studio"], ["documents", "video-studio"], ["repos", "video-studio"],
            ["video-studio", "MP4"], ["video-studio", "captions"], ["video-studio", "thumbnail"],
            ["video-studio", "social copy"], ["video-studio", "manifest"], ["video-studio", "provenance"]
          ]
        }
      },
      "visual_requirements": { "continuity_refs": ["s02"] },
      "claim_refs": ["markdown:README.md#L3-L6"],
      "transition": "cut"
    },
    {
      "id": "s04",
      "duration_sec": 6.5,
      "purpose": "point",
      "voiceover": "Claude writes the brief and the scene spec. A bundled engine validates, renders and runs QA.",
      "on_screen_text": "Claude writes. Engine checks.",
      "visual_strategy": "motion_graphic",
      "deterministic": {
        "kind": "diagram",
        "props": {
          "nodes": ["Claude", "creative brief", "scene spec", "engine", "validate", "render", "QA"],
          "edges": [
            ["Claude", "creative brief"], ["Claude", "scene spec"], ["scene spec", "engine"],
            ["engine", "validate"], ["engine", "render"], ["engine", "QA"]
          ]
        }
      },
      "visual_requirements": { "continuity_refs": ["s03"] },
      "claim_refs": ["markdown:README.md#L3-L6"],
      "transition": "cut"
    },
    {
      "id": "s05",
      "duration_sec": 4.5,
      "purpose": "proof",
      "voiceover": "The plugin needs no LLM API key. Claude does the writing.",
      "on_screen_text": "No LLM API key",
      "visual_strategy": "motion_graphic",
      "deterministic": {
        "kind": "typography",
        "props": { "lines": ["No LLM API key"], "emphasis": "No" }
