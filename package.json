{
  "name": "video-studio-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "schemas": "pnpm --filter @video-studio/schema run emit",
    "bundle": "pnpm --filter @video-studio/mcp run bundle",
    "smoke": "node scripts/smoke-mcp.mjs",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
