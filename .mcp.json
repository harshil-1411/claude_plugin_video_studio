{
  "mcpServers": {
    "engine": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp.mjs"],
      "env": {
        "RUNWAYML_API_SECRET": "${user_config.runway_key}",
        "ELEVENLABS_API_KEY": "${user_config.elevenlabs_key}",
        "HEYGEN_API_KEY": "${user_config.heygen_key}",
        "FAL_KEY": "${user_config.fal_key}",
        "KLINGAI_API_KEY": "${user_config.kling_key}",
        "GEMINI_API_KEY": "${user_config.google_key}",
        "ARK_API_KEY": "${user_config.ark_key}",
        "DASHSCOPE_API_KEY": "${user_config.dashscope_key}",
        "MINIMAX_API_KEY": "${user_config.minimax_key}",
        "YOUTUBE_CLIENT_ID": "${user_config.youtube_client_id}",
        "YOUTUBE_CLIENT_SECRET": "${user_config.youtube_client_secret}",
        "META_ACCESS_TOKEN": "${user_config.meta_access_token}",
        "LINKEDIN_ACCESS_TOKEN": "${user_config.linkedin_access_token}",
        "TIKTOK_CLIENT_KEY": "${user_config.tiktok_client_key}",
        "TIKTOK_CLIENT_SECRET": "${user_config.tiktok_client_secret}"
      }
    }
  }
}
